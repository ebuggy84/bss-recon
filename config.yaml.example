# BSS Recon Configuration
# Copy this to config.yaml and fill in your API keys

# API Keys - leave blank to skip that module
api_keys:
  shodan: ""           # Free tier: 100 queries/month - https://account.shodan.io
  virustotal: ""       # Free tier: 500 requests/day - https://virustotal.com
  securitytrails: ""   # Free tier: 50 queries/month - https://securitytrails.com
  hunter_io: ""        # Free tier: 25 searches/month - https://hunter.io
  anthropic: ""        # Optional: AI-powered analysis - https://console.anthropic.com

# Scan settings
scan:
  timeout: 10          # Seconds to wait per connection
  max_subdomains: 500  # Cap subdomain results
  user_agent: "BSS-Recon/1.0 (Security Assessment)"
  rate_limit: 1.0      # Seconds between requests (be nice to servers)

# Report settings
reporting:
  company_name: "Burgohy Security Solutions"
  analyst_name: "Emilio Burgohy"
  report_dir: "./reports"
  logo_path: ""        # Path to BSS logo for PDF reports

# Output settings
output:
  save_json: true      # Auto-save raw results as JSON
  output_dir: "./output"

# Modules to run by default (override with --modules flag)
default_modules:
  - whois
  - dns
  - subdomains
  - ssl
  - wafdetect
  - headers
  - techdetect
  - webprobe
  - jsanalyze
  - dorks
  - diff
  - shodan
  - virustotal
  - hunter
  - score
  # - virustotal      # Uncomment when you add your API key
  # NOTE: 'nuclei' is deliberately NOT a default module. It is an ACTIVE
  # scanner that fires real probes and only runs with --active --accept-roe.

# ─── Scope enforcement (REQUIRED for active modules) ─────────────────────
# Active modules (nuclei, webprobe, nmap, ...) refuse to touch a target that
# isn't in scope. Point this at your per-engagement scope file; if omitted,
# <repo root>/scope.yaml is used. See bssrecon/scope.example.yaml.
# With no scope file at all, active scanning runs UNENFORCED and is flagged.
scope:
  file: "./scope.yaml"

# ─── Nuclei (active vulnerability scanner) ───────────────────────────────
nuclei:
  # Politeness. Both default to the scan profile (stealth/balanced/aggressive);
  # set these to override and pin an explicit rate for a fragile target.
  rate_limit: 15       # max requests/second (-rl)
  concurrency: 5       # parallel templates (-c)

  # Nuclei's template library updates separately from the binary and changes
  # daily. Scans always run with -duc so they never stall or shift behaviour
  # mid-engagement; set this true to explicitly refresh templates first.
  update_templates: false
  update_timeout: 180

  # Optional: force a specific URL/scheme. Default sends the bare hostname so
  # nuclei probes both http and https.
  # target_url: "https://example.com"
